      }
    ],
    "sqlSource": {
      "queries": [
        {
          "correspondingQuestion": "Top 10 alerts by risk score in the last 24 hours",
          "sqlText": "SELECT ALERT_ID, ALERT_TS, ACCOUNT_ID, CUSTOMER_ID, ALERT_TYPE, SEVERITY, RISK_SCORE FROM REGULENS_DB.SIGNALS.ALERT WHERE ALERT_TS >= DATEADD('hour', -24, CURRENT_TIMESTAMP()) ORDER BY RISK_SCORE DESC NULLS LAST LIMIT 10"
        },
        {
          "correspondingQuestion": "How many SAR reports were created today?",
          "sqlText": "SELECT COUNT(*) AS SAR_REPORTS_TODAY FROM REGULENS_DB.EVIDENCE.SAR_REPORT WHERE CREATED_AT >= DATE_TRUNC('day', CURRENT_TIMESTAMP())"
        },
        {
          "correspondingQuestion": "For the latest SAR report, list evidence items by type",
          "sqlText": "WITH latest AS (SELECT FINDING_ID FROM REGULENS_DB.EVIDENCE.SAR_REPORT ORDER BY CREATED_AT DESC LIMIT 1) SELECT EVIDENCE_TYPE, COUNT(*) AS N FROM REGULENS_DB.EVIDENCE.EVIDENCE_ITEM e JOIN latest l ON e.FINDING_ID = l.FINDING_ID GROUP BY 1 ORDER BY 1"
        }
      ]
    }
  }
